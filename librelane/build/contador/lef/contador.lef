        RECT 25.570 2.000 73.550 2.300 ;
        RECT 74.850 2.000 91.700 2.300 ;
      LAYER Metal3 ;
        RECT 2.000 50.210 98.000 82.460 ;
        RECT 2.300 48.910 97.700 50.210 ;
        RECT 2.000 15.540 98.000 48.910 ;
      LAYER Metal4 ;
        RECT 31.500 74.570 31.780 77.750 ;
