    END
    PORT
      LAYER Metal5 ;
        RECT -4.280 71.330 103.960 73.330 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal4 ;
        RECT -4.280 4.680 -2.280 93.320 ;
    END
    PORT
      LAYER Metal4 ;
        RECT 101.960 4.680 103.960 93.320 ;
    END
    PORT
      LAYER Metal5 ;
        RECT -4.280 4.680 103.960 6.680 ;
    END
    PORT
      LAYER Metal5 ;
