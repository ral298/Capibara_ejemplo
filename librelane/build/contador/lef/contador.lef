    END
    PORT
      LAYER Metal4 ;
        RECT 26.040 4.680 28.040 93.320 ;
    END
    PORT
      LAYER Metal4 ;
        RECT 46.040 4.680 48.040 93.320 ;
    END
    PORT
      LAYER Metal4 ;
        RECT 66.040 4.680 68.040 93.320 ;
    END
    PORT
      LAYER Metal4 ;
