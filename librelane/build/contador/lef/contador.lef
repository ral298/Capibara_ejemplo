VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO contador
  CLASS BLOCK ;
  FOREIGN contador ;
  ORIGIN 0.000 0.000 ;
  SIZE 100.000 BY 100.000 ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal4 ;
        RECT -1.280 7.680 0.720 90.320 ;
    END
    PORT
      LAYER Metal4 ;
        RECT 98.960 7.680 100.960 90.320 ;
    END
    PORT
      LAYER Metal5 ;
        RECT -1.280 7.680 100.960 9.680 ;
    END
    PORT
      LAYER Metal5 ;
        RECT -1.280 88.320 100.960 90.320 ;
    END
    PORT
      LAYER Metal4 ;
