    END
    PORT
      LAYER Metal5 ;
        RECT -4.280 35.330 103.960 37.330 ;
    END
    PORT
      LAYER Metal5 ;
        RECT -4.280 55.330 103.960 57.330 ;
    END
    PORT
      LAYER Metal5 ;
        RECT -4.280 75.330 103.960 77.330 ;
    END
  END VSS
  PIN enable
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.666400 ;
    PORT
      LAYER Metal2 ;
        RECT 24.570 0.000 25.270 2.000 ;
    END
  END enable
  PIN reloj
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.666400 ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 49.210 2.000 49.910 ;
    END
  END reloj
  PIN reset
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.666400 ;
    PORT
      LAYER Metal3 ;
        RECT 98.000 49.210 100.000 49.910 ;
    END
  END reset
  PIN resultado[0]
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 1.237600 ;
    PORT
      LAYER Metal2 ;
        RECT 12.250 98.000 12.950 100.000 ;
    END
  END resultado[0]
  PIN resultado[1]
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 1.237600 ;
    PORT
      LAYER Metal2 ;
        RECT 36.890 98.000 37.590 100.000 ;
    END
  END resultado[1]
  PIN resultado[2]
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 1.237600 ;
    PORT
      LAYER Metal2 ;
        RECT 61.530 98.000 62.230 100.000 ;
    END
  END resultado[2]
  PIN resultado[3]
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 1.237600 ;
    PORT
      LAYER Metal2 ;
        RECT 86.170 98.000 86.870 100.000 ;
    END
  END resultado[3]
  PIN suma_resta
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.666400 ;
    PORT
      LAYER Metal2 ;
        RECT 73.850 0.000 74.550 2.000 ;
    END
  END suma_resta
  OBS
      LAYER Nwell ;
        RECT 6.290 15.250 93.390 82.750 ;
      LAYER Metal1 ;
        RECT 6.720 15.380 92.960 82.620 ;
      LAYER Metal2 ;
        RECT 8.260 97.700 11.950 98.000 ;
